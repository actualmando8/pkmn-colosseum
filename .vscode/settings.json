{
    "files.associations": {
        "*.h": "c",
        "*.c": "c",
        "*.inc": "asm"
    },
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/src"
    ],
    "C_Cpp.default.defines": [
        "__MWERKS__",
        "GAMECUBE",
        "TARGET_PC=0"
    ],
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "files.trimTrailingWhitespace": true,
    "files.exclude": {
        "build/": true,
        "orig/": true,
        "tools/mwcc_compiler/": true
    },
    "search.exclude": {
        "build/": true,
        "orig/": true
    }
}
