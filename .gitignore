# IDE folders
.idea/
.vs/

# Secrets — API keys for cloud model benchmarking
openrouterkey.txt
*_apikey.txt
*.key

# Caches
__pycache__/
.mypy_cache/
.cache/

# Original game files (user must supply their own)
orig/*/*
!orig/*/.gitkeep
*.dol
*.rel
*.elf
*.o
*.map
*.MAP
*.iso
*.gcm
*.ciso
*.rvz

# Build artifacts
build/
.ninja_*
build.ninja

# decompctx output
ctx.*
*.ctx

# Generated configs
# Note: objdiff.json is hand-maintained (per-unit mappings) and IS tracked —
# the objdiff GUI and decomp.dev both need it. configure.py only writes a stub
# when it is absent and never overwrites it.
compile_commands.json

# Toolchain binaries
tools/mwcc_compiler/
tools/dtk
tools/dtk.exe
tools/objdiff-cli.exe

# Dolphin (extracted locally, not part of project)
dolphin-2603a-x64/

# Claude memory (per-user)
.claude/

# CLAUDE.md files in subdirectories
**/CLAUDE.md

# Miscellaneous
/*.txt
!requirements.txt
*.exe
*.orig
*.pre
build/.measure_cache.json
build/.harvest_cursor.json
tools/decomp_work/reports/
tools/decomp_work/lane_manifest.json
tools/decomp_work/lane_manifest.json.tmp

# Root-level scratch diff/match JSON dumps (regenerable by pipeline tools)
/_diff*.json
/diff_*.json
/diff_cache_*.json
/tmp_diff*.json
/tmp_*.json
/match_*.json
/_objdiff_*.json
/scratch_*.json
/gfw_*.json
/fn_*_diff.json
/fn_*_current_diff.json
/fn_*_report.json
/diff_iter*.json
/diff_one.json
/diff_a08.json

# Root-level stray object/assembly files (build artifacts in wrong place)
/*.s
/*.obj
/NUL.obj
/nul

# Root-level scratch output files
/_diff*.out
/_objdump_input.err
/compiler_comparison_results.json

# Tools scratch diff/match JSON in tools/
tools/_diff_*.json
tools/_fn_*_diff.json
tools/diff_*.json

# Tools scratch text result dumps
tools/*_source.txt
tools/fn_*_source.txt
tools/col_*.txt
tools/cc_*.txt
tools/compile_*.txt
tools/match_*.txt
tools/_*.txt

# Tools scratch .c/.o experiments (codegen experiments, not source)
tools/_*.c
tools/_*.o

# Attic (moved dead code, never commit)
tools/attic/

# Secrets — additional key file patterns
deepseek*.txt
*_key.txt
*key*.txt
!requirements.txt

# decomp-permuter harness: external clones + per-run artifacts (scripts ARE tracked)
tools/decomp_work/refs/
tools/decomp_work/permuter/dirs/
tools/decomp_work/permuter/logs/
tools/decomp_work/permuter/wins/
tools/decomp_work/permuter/scratch/
