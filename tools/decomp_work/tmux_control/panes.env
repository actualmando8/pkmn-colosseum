# panes.env - decomp cockpit registry (written by launch-decomp.ps1 from captured pane ids).
# claude=orchestrator Opus (self) | worker=Opus | sonnet=Sonnet | glm=GLM | codex/codex2..8=Codex (8 lanes)
CLAUDE_PANE="%3"
WORKER_PANE="%5"
SONNET_PANE="%8"  # NOTE: now an OPUS worker (Sonnet retired 2026-06-20); "SON" lane label = Opus2
GLM_PANE="%7"
CODEX_PANE="%4"
CODEX2_PANE="%10"
CODEX3_PANE="%9"
CODEX4_PANE="%11"
CODEX5_PANE="%12"
CODEX6_PANE="%13"
CODEX7_PANE="%14"
CODEX8_PANE="%15"
PROXY_PANE="%1"
PERMUTER_PANE="%6"
